# ═════════════════════════════════════════════════════════════════════════════
#  SkylineA2A — Environment variables (EXAMPLE — committed to repo)
# ═════════════════════════════════════════════════════════════════════════════
#  Copy this file to `.env` and fill in real values.
#  `.env` is gitignored; this `.env.example` is safe to commit.
# ═════════════════════════════════════════════════════════════════════════════


# ─── Azure subscription / tenant ─────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-skyline-a2a"
AZURE_LOCATION="westeurope"


# ─── Microsoft Foundry project ───────────────────────────────────────────────
# Endpoint shape:
#   https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT="https://example-account.services.ai.azure.com/api/projects/example-project"

# Name of the model deployment inside the Foundry project.
FOUNDRY_DEPLOYMENT_NAME="gpt-5.2"


# ─── Demo 1 — Foundry A2A agent (Microsoft Docs Expert) ─────────────────────
DEMO1_AGENT_NAME="ms-docs-expert"
DEMO1_AGENT_DESCRIPTION="Microsoft documentation expert grounded in Microsoft Learn via MCP."
DEMO1_AGENT_VERSION="1.0.0"

# Microsoft Learn MCP server (public, no auth required, streamable HTTP).
MCP_LEARN_ENDPOINT="https://learn.microsoft.com/api/mcp"

DEMO1_A2A_BASE_URL=""
DEMO1_AGENT_CARD_URL=""


# ─── Demo 2 — Microsoft Agent Framework A2A server (DevOps Helper) ──────────
DEMO2_AGENT_NAME="MAFAgent-DevOpsHelper"
DEMO2_AGENT_DESCRIPTION="DevOps helper exposed as an A2A endpoint by the Microsoft Agent Framework."
DEMO2_AGENT_VERSION="1.0.0"

DEMO2_HOST="0.0.0.0"
DEMO2_PORT="9999"
DEMO2_PUBLIC_URL="http://localhost:9999/"

# Demo 2 reuses FOUNDRY_PROJECT_ENDPOINT + FOUNDRY_DEPLOYMENT_NAME (above)
# via FoundryChatClient — no separate Azure OpenAI resource is required.


# ─── Azure Container Registry ────────────────────────────────────────────────
ACR_NAME="skylineacr"
ACR_LOGIN_SERVER="skylineacr.azurecr.io"
ACR_IMAGE_NAME="skyline-maf-agent"
ACR_IMAGE_TAG="latest"


# ─── Azure Container Apps ────────────────────────────────────────────────────
ACA_NAME="ca-skyline-maf-agent"
ACA_ENVIRONMENT="cae-skyline"
ACA_FQDN=""


# ─── Azure API Management ────────────────────────────────────────────────────
APIM_NAME="apim-skyline"
APIM_RESOURCE_GROUP="rg-skyline-a2a"
APIM_GATEWAY_URL="https://apim-skyline.azure-api.net"

APIM_SUBSCRIPTION_KEY_FREE=""
APIM_SUBSCRIPTION_KEY_PRO=""
